rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role;
    }
    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    match /users/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if false;
    }
    match /patients/{id} {
      allow read: if isAdmin()
        || (role() == 'patient' && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.patient_id == int(id))
        || (role() == 'doctor' && exists(/databases/$(database)/documents/relationships/$(id + '_' + get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.doctor_id)));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || role() == 'doctor';
    }
    match /doctors/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (role() == 'doctor' && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.doctor_id == id);
    }
    match /relationships/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /appointments/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin() || role() == 'doctor' || role() == 'patient';
    }
    match /conversations/{id} {
      allow read, write: if signedIn() && (
        isAdmin()
        || request.auth.token.email == resource.data.patient_email
        || request.auth.token.email == resource.data.doctor_email
        || request.auth.token.email == request.resource.data.patient_email
        || request.auth.token.email == request.resource.data.doctor_email
      );
    }
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sender_id == request.auth.token.email;
      allow update: if signedIn() && resource.data.receiver_id == request.auth.token.email;
    }
    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.user_email == request.auth.token.email;
      allow create: if false;
    }
  }
}
